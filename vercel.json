{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/login(?:\\.php)?/?$",
      "dest": "/login.html"
    },
    {
      "src": "^/register(?:\\.php)?/?$",
      "dest": "/login.html"
    },
    {
      "src": "^/(css|js)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)",
      "dest": "/$1"
    }
  ]
}
