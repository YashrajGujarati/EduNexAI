# Vercel static deployment — only index.html, login.html, css/, js/ are served
# All backend PHP, Python, and server files are excluded

# PHP backend files
*.php
admin/
faculty/
student/
config/
database/
includes/

# Python analytics (server-side only)
python/

# Dependencies and build tools
vendor/
fpdf/
composer.json
composer.lock
package.json
node_modules/

# Environment & secrets
.env
.env.*

# Database files
*.sql
*.json.bak

# Docs and server config
*.md
