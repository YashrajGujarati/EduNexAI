# ============================================================
# EduNexAI — Vercel Static Deployment Ignore Rules
#
# Vercel serves ONLY: index.html, login.html, css/, js/
# All PHP/Python backend files stay on Railway (Docker).
# ============================================================

# ── PHP backend files (run on Railway, not Vercel) ─────────
*.php
admin/
faculty/
student/
config/
database/
includes/

# ── Python analytics (server-side only) ────────────────────
python/

# ── PHP/Composer dependencies ──────────────────────────────
vendor/
fpdf/
composer.json
composer.lock

# ── Node dependencies (not needed for static deploy) ───────
node_modules/
package.json
package-lock.json

# ── Docker / Railway deployment files ──────────────────────
# NOTE: These are needed by Railway but not by Vercel
Dockerfile
docker-entrypoint.sh
railway.json

# ── Secrets — NEVER deploy to Vercel ───────────────────────
.env
.env.local
.env.production
.env.development

# ── Database dumps ─────────────────────────────────────────
*.sql

# ── Docs ───────────────────────────────────────────────────
*.md
