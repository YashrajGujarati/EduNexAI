# ============================================================
# EduNexAI — Environment Configuration Template
# Copy to .env for local development or set in Railway variables.
# NEVER commit sensitive passwords to version control!
# ============================================================

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=student_ai_system

# Legacy Database Fallback (Optional)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_ai_system
DB_USER=root
DB_PASSWORD=

# Gemini AI API Key (Optional)
GEMINI_API_KEY=

# Application Settings
APP_ENV=production
APP_DEBUG=false

# URLs
BACKEND_URL=
FRONTEND_URL=
