# ============================================================
# EduNexAI — Environment Variables Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to Git — it is in .gitignore.
#
# ── RAILWAY: Set these as Environment Variables in Railway dashboard ──
# ── VERCEL:  Set FRONTEND_URL and ALLOWED_ORIGINS in Vercel dashboard ──
# ============================================================

# ── MongoDB Atlas (Required) ──────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=student_ai_system

# ── App Settings ──────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ── CORS: Your Vercel frontend URL (set on Railway) ───────────
# This tells the PHP backend which frontend origin to allow.
# Example: https://edu-nex-ai.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# Also add as comma-separated if multiple origins needed:
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ── Gemini AI (Optional) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
